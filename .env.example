# コピーして .env にし、chmod 600 にしてください（.env はコミットしません）

# CAPCOM ID（自動ログイン用）
CAPCOM_ID=
CAPCOM_PASSWORD=

# 自分のユーザーコード（login コマンドの確認に使用）
MY_ID=4050953661

# Google スプレッドシート（空なら targets.csv を読みます）
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
SHEET_TARGETS_TAB=対象
SHEET_RECORD_TAB=記録

# Discord Webhook（空なら標準出力に表示のみ）
DISCORD_WEBHOOK_URL=

# Playwright の Chromium が入らない場合のみ指定（例: /usr/bin/chromium）
CHROMIUM_PATH=

# 保存先（相対パスはこのフォルダ基準）
DB_PATH=data/sf6mr.sqlite3
STATE_FILE=data/session_state.json
DEBUG_DIR=data/debug
EXPORT_JSON=data/mr.json
TARGETS_CSV=targets.csv
